<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>AutoUpdate.Tests</AssemblyName>
    <DebugType>none</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/_/HackerAmongUs/tests/AutoUpdate.Tests</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../installer/HAU.Setup.Core/HAU.Setup.Core.csproj" />
    <Compile Include="../../installer/HAU.Setup/UpdateCommand.cs" Link="UpdateCommand.cs" />
  </ItemGroup>
</Project>
