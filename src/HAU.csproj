<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <DebugType>embedded</DebugType>
        <EnableSourceLink>false</EnableSourceLink>
        <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))=/_/HAU</PathMap>

        <AssemblyName>HAU</AssemblyName>
        <Product>Hacker Among Us</Product>
        <Title>Hacker Among Us</Title>
        <AssemblyTitle>Hacker Among Us</AssemblyTitle>
        <Company>Rifegul</Company>
        <VersionPrefix>1.0.2</VersionPrefix>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Description>Hacker Among Us (HAU) by Rifegul.</Description>
        <Authors>Rifegul</Authors>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GuestKillExperiment)' == 'true'">
        <DefineConstants>$(DefineConstants);GUEST_KILL_EXPERIMENT</DefineConstants>
        <VersionSuffix>guest-test</VersionSuffix>
    </PropertyGroup>

    <PropertyGroup Condition="'$(JudgeRoleExperiment)' == 'true'">
        <DefineConstants>$(DefineConstants);GUEST_KILL_EXPERIMENT;JUDGE_ROLE_EXPERIMENT</DefineConstants>
        <VersionSuffix>judge-test</VersionSuffix>
    </PropertyGroup>



    <ItemGroup>
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.788" Private="false" ExcludeAssets="runtime;native" />
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" PrivateAssets="all" />

        <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <InteropReferencesDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../artifacts/interop/among-us-2026.9.29-interop-1.5.3'))</InteropReferencesDirectory>
        <InteropPython Condition="'$(InteropPython)' == ''">python</InteropPython>
    </PropertyGroup>


    <Target Name="PrepareHAUInteropReferences" BeforeTargets="ResolveAssemblyReferences" Condition="'$(DesignTimeBuild)' != 'true'">
        <Exec Command="&quot;$(InteropPython)&quot; &quot;$(MSBuildProjectDirectory)/../scripts/prepare-interop.py&quot; --quiet" />
        <ItemGroup>
            <Reference Include="$(InteropReferencesDirectory)/*.dll" Private="false" />
        </ItemGroup>
        <Error Condition="!Exists('$(InteropReferencesDirectory)/Assembly-CSharp.dll')" Text="HAU game references are missing. Run python scripts/prepare-interop.py from the repository root." />
    </Target>

    <Target Name="Copy" AfterTargets="Build" Condition="'$(AmongUs)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUs)/BepInEx/plugins/" UseSymboliclinksIfPossible="true" />
    </Target>
</Project>
